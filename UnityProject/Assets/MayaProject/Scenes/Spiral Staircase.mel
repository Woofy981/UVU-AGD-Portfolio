proc BuildStaircase(int $steps, int $length, int $width, float $Height, float $Offset, float $stepH, float $stepRot){
   
    for($i=0; $i<$steps; $i++){
        polyCube -w $width -h $Height -d $length;
        rotate 0 ($i * ($stepRot / $steps)) 0;
        move -os 0 ($i * $stepH) (($length / 2) + $Offset);
    }

    polyCylinder -r $width -h ($stepH * $steps);
    move 0 (($stepH * $steps) / 2) 0;
}

